generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              BigInt             @id @default(autoincrement())
  username        String             @unique @db.VarChar(64)
  passwordHash    String             @map("password_hash")
  name            String             @db.VarChar(100)
  isPlatformAdmin Boolean            @default(false) @map("is_platform_admin")
  isActive        Boolean            @default(true) @map("is_active")
  memberships     TenantMembership[]
  sessions        Session[]

  @@map("app_users")
}

model SiteSettings {
  id              Int      @id @default(1)
  title           String   @db.VarChar(100)
  logo            String   @db.VarChar(2048)
  loginBackground String   @map("login_background") @db.VarChar(2048)
  footerText      String   @map("footer_text") @db.VarChar(200)
  colorPrimary    String   @map("color_primary") @db.VarChar(7)
  defaultLocale   String   @map("default_locale") @db.VarChar(20)
  revision        Int      @default(0)

  @@map("app_site_settings")
}

model SiteSettingsAudit {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt   @map("actor_id")
  actorName String   @map("actor_name") @db.VarChar(100)
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("app_site_settings_audits")
}

model Tenant {
  id           BigInt             @id @default(autoincrement())
  code         String             @unique @db.VarChar(64)
  name         String             @db.VarChar(100)
  isActive     Boolean            @default(true) @map("is_active")
  memberships  TenantMembership[]
  subscription Subscription?
  features     TenantFeature[]
  roles        TenantRole[]

  @@map("app_tenants")
}

model Feature {
  code     String          @id @db.VarChar(64)
  name     String          @db.VarChar(100)
  tenants  TenantFeature[]
  menus    Menu[]

  @@map("app_features")
}

model TenantFeature {
  tenantId    BigInt  @map("tenant_id")
  featureCode String  @map("feature_code") @db.VarChar(64)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feature     Feature @relation(fields: [featureCode], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@id([tenantId, featureCode])
  @@map("app_tenant_features")
}

model Menu {
  code        String  @id @db.VarChar(64)
  parentCode  String? @map("parent_code") @db.VarChar(64)
  parent      Menu?   @relation("MenuTree", fields: [parentCode], references: [code], onDelete: Restrict, onUpdate: NoAction)
  children    Menu[]  @relation("MenuTree")
  kind        String  @default("page") @db.VarChar(20)
  path        String? @unique @db.VarChar(200)
  name        String  @db.VarChar(100)
  i18nKey     String? @map("i18n_key") @db.VarChar(150)
  icon        String  @default("") @db.VarChar(64)
  sortOrder   Int     @default(0) @map("sort_order")
  scope       String  @db.VarChar(20)
  minRole     String  @default("user") @map("min_role") @db.VarChar(20)
  isActive    Boolean @default(true) @map("is_active")
  featureCode String? @map("feature_code") @db.VarChar(64)
  feature     Feature? @relation(fields: [featureCode], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([parentCode])
  @@map("app_menus")
}

model TenantMembership {
  tenantId BigInt    @map("tenant_id")
  userId   BigInt    @map("user_id")
  // The admin/user CHECK constraint is maintained in the migration.
  role     String    @default("user") @db.VarChar(20)
  isActive Boolean   @default(true) @map("is_active")
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions Session[]
  roles    MemberRole[]

  @@id([tenantId, userId])
  @@index([userId])
  @@map("app_tenant_memberships")
}

model TenantRole {
  id          BigInt       @id @default(autoincrement())
  tenantId    BigInt       @map("tenant_id")
  name        String       @db.VarChar(100)
  permissions String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     MemberRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("app_tenant_roles")
}

model MemberRole {
  tenantId BigInt @map("tenant_id")
  userId   BigInt @map("user_id")
  roleId   BigInt @map("role_id")
  member   TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  role     TenantRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, userId, roleId])
  @@map("app_member_roles")
}

model Session {
  tokenHash  String            @id @map("token_hash") @db.Char(64)
  userId     BigInt            @map("user_id")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  tenantId   BigInt?           @map("tenant_id")
  membership TenantMembership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade, onUpdate: NoAction)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId])
  @@map("app_sessions")
}

model Plan {
  id            BigInt         @id @default(autoincrement())
  code          String         @unique @db.VarChar(64)
  name          String         @db.VarChar(100)
  maxMembers    Int            @map("max_members")
  isActive      Boolean        @default(true) @map("is_active")
  subscriptions Subscription[]

  @@map("app_plans")
}

model Subscription {
  tenantId  BigInt   @id @map("tenant_id")
  planId    BigInt   @map("plan_id")
  startsAt  DateTime @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([planId])
  @@map("app_subscriptions")
}
