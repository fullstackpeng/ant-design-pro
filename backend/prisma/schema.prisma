generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              BigInt             @id @default(autoincrement())
  username        String             @unique @db.VarChar(64)
  passwordHash    String             @map("password_hash")
  name            String             @db.VarChar(100)
  isPlatformAdmin Boolean            @default(false) @map("is_platform_admin")
  isActive        Boolean            @default(true) @map("is_active")
  memberships     TenantMembership[]
  sessions        Session[]

  @@map("app_users")
}

model SiteSettings {
  id              Int      @id @default(1)
  title           String   @db.VarChar(100)
  logo            String   @db.VarChar(2048)
  loginBackground String   @map("login_background") @db.VarChar(2048)
  footerText      String   @map("footer_text") @db.VarChar(200)
  colorPrimary    String   @map("color_primary") @db.VarChar(7)
  defaultLocale   String   @map("default_locale") @db.VarChar(20)
  revision        Int      @default(0)

  @@map("app_site_settings")
}

model SiteSettingsAudit {
  id        BigInt   @id @default(autoincrement())
  actorId   BigInt   @map("actor_id")
  actorName String   @map("actor_name") @db.VarChar(100)
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("app_site_settings_audits")
}

model Tenant {
  id           BigInt             @id @default(autoincrement())
  code         String             @unique @db.VarChar(64)
  name         String             @db.VarChar(100)
  industry     String             @default("") @db.VarChar(64)
  isActive     Boolean            @default(true) @map("is_active")
  memberships  TenantMembership[]
  subscription Subscription?
  features     TenantFeature[]
  roles        TenantRole[]
  dictionaries DictionaryType[]
  dictionaryAudits DictionaryAudit[]
  files        FileObject[]
  mqttCredentials TenantMqttCredential[]
  mqttBrokers  TenantMqttBroker[]
  mqttMessages MqttMessage[]

  @@map("app_tenants")
}

model Feature {
  code           String          @id @db.VarChar(64)
  name           String          @db.VarChar(100)
  description    String          @default("") @db.VarChar(500)
  category       String          @default("base") @db.VarChar(32)
  sortOrder      Int             @default(0) @map("sort_order")
  isDemo         Boolean         @default(false) @map("is_demo")
  defaultGranted Boolean         @default(false) @map("default_granted")
  tenants        TenantFeature[]
  menus          Menu[]

  @@map("app_features")
}

model TenantFeature {
  tenantId    BigInt  @map("tenant_id")
  featureCode String  @map("feature_code") @db.VarChar(64)
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  feature     Feature @relation(fields: [featureCode], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@id([tenantId, featureCode])
  @@map("app_tenant_features")
}

model Menu {
  code        String  @id @db.VarChar(64)
  parentCode  String? @map("parent_code") @db.VarChar(64)
  parent      Menu?   @relation("MenuTree", fields: [parentCode], references: [code], onDelete: Restrict, onUpdate: NoAction)
  children    Menu[]  @relation("MenuTree")
  kind        String  @default("page") @db.VarChar(20)
  path        String? @unique @db.VarChar(200)
  name        String  @db.VarChar(100)
  i18nKey     String? @map("i18n_key") @db.VarChar(150)
  icon        String  @default("") @db.VarChar(64)
  sortOrder   Int     @default(0) @map("sort_order")
  scope       String  @db.VarChar(20)
  minRole     String  @default("user") @map("min_role") @db.VarChar(20)
  isActive    Boolean @default(true) @map("is_active")
  featureCode String? @map("feature_code") @db.VarChar(64)
  feature     Feature? @relation(fields: [featureCode], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@index([parentCode])
  @@map("app_menus")
}

model TenantMembership {
  tenantId BigInt    @map("tenant_id")
  userId   BigInt    @map("user_id")
  // The admin/user CHECK constraint is maintained in the migration.
  role     String    @default("user") @db.VarChar(20)
  isActive Boolean   @default(true) @map("is_active")
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessions Session[]
  roles    MemberRole[]

  @@id([tenantId, userId])
  @@index([userId])
  @@map("app_tenant_memberships")
}

model TenantRole {
  id          BigInt       @id @default(autoincrement())
  tenantId    BigInt       @map("tenant_id")
  name        String       @db.VarChar(100)
  permissions String[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     MemberRole[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@map("app_tenant_roles")
}

model MemberRole {
  tenantId BigInt @map("tenant_id")
  userId   BigInt @map("user_id")
  roleId   BigInt @map("role_id")
  member   TenantMembership @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  role     TenantRole @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)

  @@id([tenantId, userId, roleId])
  @@map("app_member_roles")
}

model Session {
  tokenHash  String            @id @map("token_hash") @db.Char(64)
  userId     BigInt            @map("user_id")
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  tenantId   BigInt?           @map("tenant_id")
  membership TenantMembership? @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade, onUpdate: NoAction)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, userId])
  @@map("app_sessions")
}

model DictionaryType {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  code     String @db.VarChar(64)
  name     String @db.VarChar(100)
  remark   String @default("") @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    DictionaryItem[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("app_dictionary_types")
}

model DictionaryItem {
  id           BigInt @id @default(autoincrement())
  tenantId     BigInt @map("tenant_id")
  dictionaryId BigInt @map("dictionary_id")
  value        String @db.VarChar(64)
  label        String @db.VarChar(100)
  sortOrder    Int @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")
  color        String @default("") @db.VarChar(20)
  dictionary   DictionaryType @relation(fields: [tenantId, dictionaryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, dictionaryId, value])
  @@unique([tenantId, id])
  @@map("app_dictionary_items")
}

model PlatformDictionaryType {
  id       BigInt @id @default(autoincrement())
  code     String @unique @db.VarChar(64)
  name     String @db.VarChar(100)
  remark   String @default("") @db.VarChar(500)
  isActive Boolean @default(true) @map("is_active")
  revision Int @default(0)
  items    PlatformDictionaryItem[]

  @@map("app_platform_dictionary_types")
}

model PlatformDictionaryItem {
  id           BigInt @id @default(autoincrement())
  dictionaryId BigInt @map("dictionary_id")
  value        String @db.VarChar(64)
  label        String @db.VarChar(100)
  sortOrder    Int @default(0) @map("sort_order")
  isActive     Boolean @default(true) @map("is_active")
  color        String @default("") @db.VarChar(20)
  revision     Int @default(0)
  dictionary   PlatformDictionaryType @relation(fields: [dictionaryId], references: [id], onDelete: Restrict)

  @@unique([dictionaryId, value])
  @@map("app_platform_dictionary_items")
}

model DictionaryAudit {
  id             BigInt @id @default(autoincrement())
  scope          String @db.VarChar(20)
  tenantId       BigInt? @map("tenant_id")
  dictionaryCode String @map("dictionary_code") @db.VarChar(64)
  entityType     String @map("entity_type") @db.VarChar(20)
  targetValue    String @default("") @map("target_value") @db.VarChar(64)
  action         String @db.VarChar(20)
  actorId        BigInt @map("actor_id")
  actorName      String @map("actor_name") @db.VarChar(100)
  before         Json
  after          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([scope, tenantId, dictionaryCode, id])
  @@map("app_dictionary_audits")
}

model Plan {
  id             BigInt         @id @default(autoincrement())
  code           String         @unique @db.VarChar(64)
  name           String         @db.VarChar(100)
  maxMembers     Int            @map("max_members")
  maxStorageMb   Int            @default(5120) @map("max_storage_mb")
  maxFileSizeMb  Int            @default(100) @map("max_file_size_mb")
  isActive       Boolean        @default(true) @map("is_active")
  subscriptions  Subscription[]

  @@map("app_plans")
}

model Subscription {
  tenantId  BigInt   @id @map("tenant_id")
  planId    BigInt   @map("plan_id")
  startsAt  DateTime @default(now()) @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  isActive  Boolean  @default(true) @map("is_active")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([planId])
  @@map("app_subscriptions")
}

model ScheduledTask {
  id              BigInt   @id @default(autoincrement())
  name            String   @db.VarChar(100)
  type            String   @default("internal") @db.VarChar(20)
  handler         String   @db.VarChar(100)
  cron            String   @db.VarChar(100)
  timezone        String   @db.VarChar(64)
  scope           String   @db.VarChar(20)
  tenantIds       String[] @map("tenant_ids")
  params          Json
  enabled         Boolean  @default(false)
  timeoutMs       Int      @map("timeout_ms")
  maxAttempts     Int      @map("max_attempts")
  concurrency     Int      @default(1)
  revision        Int      @default(1)
  syncedRevision  Int      @default(0) @map("synced_revision")
  syncError       String   @default("") @map("sync_error") @db.VarChar(2000)
  syncToken       String?  @map("sync_token")
  syncUntil       DateTime? @map("sync_until") @db.Timestamptz(6)
  executionFence  Int      @default(0) @map("execution_fence")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  dispatches      TaskDispatch[]
  runs            TaskRun[]
  audits          TaskAudit[]

  @@map("app_scheduled_tasks")
}

model TaskDispatch {
  id         String   @id
  taskId     BigInt   @map("task_id")
  source     String   @db.VarChar(20)
  snapshot   Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task       ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  runs       TaskRun[]

  @@index([taskId, createdAt])
  @@map("app_task_dispatches")
}

model TaskRun {
  id             String   @id
  taskId         BigInt   @map("task_id")
  dispatchId     String   @map("dispatch_id")
  targetKey      String   @map("target_key")
  tenantId       BigInt?  @map("tenant_id")
  taskName       String   @map("task_name") @db.VarChar(100)
  type           String   @db.VarChar(20)
  source         String   @db.VarChar(20)
  snapshot       Json
  idempotencyKey String   @map("idempotency_key")
  retryOf        String?  @map("retry_of")
  status         String   @default("queued") @db.VarChar(20)
  attemptsMade   Int      @default(0) @map("attempts_made")
  leaseToken     String?  @map("lease_token")
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs     Int?     @map("duration_ms")
  error          String   @default("") @db.VarChar(2000)
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task           ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  dispatch       TaskDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  attempts       TaskAttempt[]

  @@unique([dispatchId, targetKey])
  @@index([status, createdAt])
  @@index([taskId, status, leaseUntil])
  @@map("app_task_runs")
}

model TaskAttempt {
  id          String   @id
  runId       String   @map("run_id")
  number      Int
  status      String   @db.VarChar(20)
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs  Int?     @map("duration_ms")
  error       String   @default("") @db.VarChar(2000)
  run         TaskRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, number])
  @@map("app_task_attempts")
}

model TaskAudit {
  id        BigInt   @id @default(autoincrement())
  taskId    BigInt   @map("task_id")
  actorId   BigInt   @map("actor_id")
  actorName String   @map("actor_name") @db.VarChar(100)
  action    String   @db.VarChar(20)
  before    Json
  after     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  task      ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, id])
  @@map("app_task_audits")
}

model StorageProvider {
  id               BigInt       @id @default(autoincrement())
  code             String       @unique @db.VarChar(64)
  name             String       @db.VarChar(100)
  protocol         String       @db.VarChar(32)
  config           Json
  // AES-256-GCM envelope. Secrets are never returned by the API.
  secrets          String       @db.Text
  secretKeys       String[]     @map("secret_keys")
  secretKeyVersion Int          @default(1) @map("secret_key_version")
  isDefault        Boolean      @default(false) @map("is_default")
  isActive         Boolean      @default(true) @map("is_active")
  revision         Int          @default(0)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  files            FileObject[]

  @@index([isDefault])
  @@map("app_storage_providers")
}

model MqttPlatformBroker {
  id               Int      @id @default(1)
  name             String   @db.VarChar(100)
  host             String   @db.VarChar(255)
  port             Int
  useTls           Boolean  @default(false) @map("use_tls")
  defaultProtocol  String   @default("3.1.1") @map("default_protocol") @db.VarChar(10)
  adminUsername    String   @map("admin_username") @db.VarChar(150)
  adminPassword    String   @map("admin_password") @db.Text
  bridgeUsername   String   @map("bridge_username") @db.VarChar(150)
  bridgePassword   String   @map("bridge_password") @db.Text
  responseTopic    String   @default("$CONTROL/dynamic-security/v1/response") @map("response_topic") @db.VarChar(200)
  commandTimeoutMs Int      @default(10000) @map("command_timeout_ms")
  isEnabled        Boolean  @default(true) @map("is_enabled")
  revision         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_mqtt_platform_brokers")
}

model TenantMqttCredential {
  id               BigInt    @id @default(autoincrement())
  tenantId         BigInt    @map("tenant_id")
  platformBrokerId Int       @default(1) @map("platform_broker_id")
  username         String    @db.VarChar(150)
  password         String    @db.Text
  roleName         String    @map("role_name") @db.VarChar(150)
  status           String    @default("pending") @db.VarChar(20)
  lastError        String    @default("") @map("last_error") @db.VarChar(2000)
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  provisionedAt    DateTime? @map("provisioned_at") @db.Timestamptz(6)
  revision         Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, platformBrokerId])
  @@index([status, nextAttemptAt])
  @@map("app_tenant_mqtt_credentials")
}

model TenantMqttBroker {
  id                   BigInt   @id @default(autoincrement())
  tenantId             BigInt   @map("tenant_id")
  name                 String   @db.VarChar(100)
  host                 String   @db.VarChar(255)
  port                 Int
  useTls               Boolean  @default(false) @map("use_tls")
  protocolVersion      String   @default("3.1.1") @map("protocol_version") @db.VarChar(10)
  username             String   @default("") @db.VarChar(150)
  password             String   @default("") @db.Text
  clientIdPrefix       String   @default("") @map("client_id_prefix") @db.VarChar(100)
  subscribeFilter      String   @default("#") @map("subscribe_filter") @db.VarChar(512)
  keepaliveSeconds     Int      @default(60) @map("keepalive_seconds")
  cleanStart           Boolean  @default(false) @map("clean_start")
  sessionExpirySeconds Int      @default(86400) @map("session_expiry_seconds")
  defaultQos           Int      @default(1) @map("default_qos")
  isDefault            Boolean  @default(false) @map("is_default")
  isActive             Boolean  @default(true) @map("is_active")
  revision             Int      @default(0)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([tenantId, name])
  @@index([tenantId, isDefault])
  @@map("app_tenant_mqtt_brokers")
}

model MqttMessage {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  brokerType      String   @map("broker_type") @db.VarChar(20)
  brokerId        BigInt   @map("broker_id")
  topic           String   @db.VarChar(512)
  payload         String   @db.Text
  payloadEncoding String   @default("utf8") @map("payload_encoding") @db.VarChar(10)
  qos             Int      @default(0)
  retain          Boolean  @default(false)
  direction       String   @db.VarChar(20)
  idempotencyKey  String   @map("idempotency_key") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([idempotencyKey])
  @@index([tenantId, id])
  @@index([brokerType, brokerId, id])
  @@index([createdAt])
  @@map("app_mqtt_messages")
}

model MqttOutbox {
  id              BigInt   @id @default(autoincrement())
  tenantId        BigInt   @map("tenant_id")
  brokerType      String   @map("broker_type") @db.VarChar(20)
  brokerId        BigInt   @map("broker_id")
  topic           String   @db.VarChar(512)
  payload         String   @db.Text
  payloadEncoding String   @default("utf8") @map("payload_encoding") @db.VarChar(10)
  qos             Int      @default(1)
  retain          Boolean  @default(false)
  status          String   @default("pending") @db.VarChar(20)
  attempts        Int      @default(0)
  lastError       String   @default("") @map("last_error") @db.VarChar(2000)
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("app_mqtt_outbox")
}

model MqttSecretAudit {
  id           BigInt   @id @default(autoincrement())
  actorId      BigInt   @map("actor_id")
  actorName    String   @map("actor_name") @db.VarChar(100)
  tenantId     BigInt?  @map("tenant_id")
  credentialId BigInt?  @map("credential_id")
  action       String   @db.VarChar(30)
  success      Boolean
  ip           String   @default("") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, action, createdAt])
  @@map("app_mqtt_secret_audits")
}

model FileObject {
  id             BigInt          @id @default(autoincrement())
  tenantId       BigInt?         @map("tenant_id")
  providerId     BigInt          @map("provider_id")
  protocol       String          @db.VarChar(32)
  objectKey      String          @map("object_key") @db.VarChar(512)
  originalName   String          @map("original_name") @db.VarChar(255)
  mimeType       String          @map("mime_type") @db.VarChar(150)
  size           BigInt
  checksum       String?         @db.VarChar(128)
  visibility     String          @default("private") @db.VarChar(20)
  uploadedBy     BigInt          @map("uploaded_by")
  uploadedByName String          @map("uploaded_by_name") @db.VarChar(100)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  provider       StorageProvider @relation(fields: [providerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([providerId, objectKey])
  @@index([tenantId, createdAt])
  @@index([providerId])
  @@map("app_files")
}
