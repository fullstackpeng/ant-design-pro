{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "npm run build && node --env-file=.env dist/main.js",
    "db:init": "npm run db:deploy && npm run db:seed",
    "test": "npm run build && node --env-file=.env --test dist/auth/auth.test.js dist/platform/platform.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "npm run build && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "7.0.2"
  }
}
