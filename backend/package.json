{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "npm run build && node --env-file=.env dist/main.js",
    "worker": "npm run build && node --env-file=.env dist/worker.js",
    "worker:prod": "node dist/worker.js",
    "queue:migrate": "npm run build && node --env-file-if-exists=.env dist/queue/migrate.js",
    "queue:migrate:prod": "node dist/queue/migrate.js",
    "queue:probe": "node --env-file-if-exists=.env dist/queue/probe.js",
    "test:ai": "npm run build && node --env-file-if-exists=.env --test --test-isolation=none dist/ai/ai.test.js",
    "test:queue": "npm run build && node --env-file-if-exists=.env --test dist/queue/queue.test.js",
    "test:tasks": "npm run build && node --env-file-if-exists=.env --test dist/scheduled-tasks/scheduled-tasks.test.js",
    "db:init": "npm run db:deploy && npm run db:seed",
    "test": "npm run build && node --env-file-if-exists=.env --test dist/ai/ai.test.js dist/auth/auth.test.js dist/platform/platform.test.js dist/openapi.test.js dist/auth/permissions.test.js dist/audit/audit-coverage.test.js dist/audit/audit.test.js dist/tenants/organization.test.js dist/account/account.test.js dist/dictionaries/dictionaries.test.js dist/files/files.test.js dist/notifications/notifications.test.js dist/mqtt/mqtt.test.js dist/realtime/realtime.test.js dist/queue/queue.test.js dist/scheduled-tasks/scheduled-tasks.test.js",
    "test:permissions": "npm run build && node --test --test-isolation=none dist/auth/permissions.test.js dist/audit/audit-coverage.test.js",
    "test:audit": "npm run build && node --env-file-if-exists=.env --test --test-isolation=none dist/audit/audit.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "npm run build && prisma db seed",
    "db:studio": "prisma studio",
    "openapi:export": "npm run build && node dist/export-openapi.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/platform-ws": "^12.5.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/websockets": "^12.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "6.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "5.10.6",
    "dotenv": "^18.0.10",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.18.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "prisma": "^7.10.1",
    "typescript": "^6.0.3"
  }
}
