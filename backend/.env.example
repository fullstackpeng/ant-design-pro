DATABASE_URL=postgresql://peng:YOUR_PASSWORD@127.0.0.1:5432/antdesign?sslmode=disable
ADMIN_PASSWORD=ant.design
DEMO_PASSWORD=ant.design
PLATFORM_ADMIN_PASSWORD=ant.design

# 32-byte base64 key used to encrypt storage and MQTT secrets (AES-256-GCM).
# Prefer SECRET_ENCRYPTION_KEY; STORAGE_SECRET_KEY is kept as a fallback.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=
STORAGE_SECRET_KEY=

# MQTT background polling intervals in milliseconds; 0 disables polling.
MQTT_PROVISION_POLL_MS=10000
MQTT_OUTBOX_POLL_MS=5000

# BullMQ uses PostgreSQL only. Empty QUEUE_DATABASE_URL reuses DATABASE_URL.
QUEUE_DATABASE_URL=
QUEUE_SCHEMA=bullmq
# Pool limit per Queue/Worker/QueueEvents backend, excluding LISTEN connections.
QUEUE_POOL_SIZE=5
# Per-worker concurrency, not a cluster-wide business concurrency limit.
QUEUE_WORKER_CONCURRENCY=2
